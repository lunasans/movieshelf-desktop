#!/bin/bash
# Nimmt ein .deb über die Standardeingabe entgegen und veröffentlicht es in der
# Paketquelle. Läuft als erzwungenes Kommando des Deploy-Schlüssels (siehe
# README.md), damit ein gestohlener Schlüssel nichts anderes ausführen kann.
#
# Aufruf von außen:  ssh apt@server < movieshelf-desktop_1.2.3_amd64.deb
#
# Absichtlich ohne Argumente: alles, was der Aufrufer schicken könnte, landet in
# SSH_ORIGINAL_COMMAND und wird hier ignoriert.
set -euo pipefail

REPO="movieshelf"
DIST="stable"
INCOMING="/srv/apt/incoming"
LOG="/var/log/apt-publish.log"

log() { echo "[$(date -Is)] $*" | tee -a "$LOG"; }

mkdir -p "$INCOMING"
upload="$INCOMING/upload-$(date +%s%N).deb"

# Obergrenze, damit ein hängender oder bösartiger Aufruf nicht die Platte füllt.
head -c 400M > "$upload"

# Prüfen, dass es wirklich ein Debian-Paket ist, bevor aptly es anfasst.
if ! dpkg-deb -I "$upload" > /dev/null 2>&1; then
  rm -f "$upload"
  log "FEHLER: keine gültige .deb-Datei empfangen"
  exit 1
fi

version=$(dpkg-deb -f "$upload" Version)
package=$(dpkg-deb -f "$upload" Package)
log "empfangen: $package $version"

# Vorabversionen (1.1.1-linux, Testpakete) gehören nicht in die stabile Quelle.
if [[ "$version" == *-* ]]; then
  rm -f "$upload"
  log "abgelehnt: $version ist eine Vorabversion"
  exit 1
fi

if aptly repo show "$REPO" > /dev/null 2>&1; then
  :
else
  log "Repository $REPO wird angelegt"
  aptly repo create -distribution="$DIST" -component=main "$REPO"
fi

aptly repo add -remove-files "$REPO" "$upload"

if aptly publish list -raw | grep -q "^. $DIST\$"; then
  aptly publish update -batch "$DIST"
else
  log "Erstveröffentlichung von $DIST"
  aptly publish repo -batch -distribution="$DIST" "$REPO"
fi

aptly db cleanup > /dev/null
log "veröffentlicht: $package $version"
